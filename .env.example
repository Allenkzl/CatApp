# Copy to a private .env file or configure these values through your service manager.
# Node does not automatically load this file. Example: node --env-file=.env scripts/serve.mjs
CAT_MODE=server
# Direct access by default; set true and a strong admin password to enable login.
CAT_REQUIRE_LOGIN=false
HOST=0.0.0.0
PORT=4173
CAT_PUBLIC_URL=https://cats.example.com
CAT_DATA_DIR=/var/lib/catapp
CAT_ADMIN_USER=admin
# Required only when CAT_REQUIRE_LOGIN=true (at least 12 characters).
CAT_ADMIN_PASSWORD=
# Optional pre-provisioned device; otherwise register one after signing in.
# CAT_DEVICE_ID=recamera-pro-01
# CAT_DEVICE_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
DEEPSEEK_API_KEY=
SEEDREAM_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
# Set false for tests without paid model calls.
CAT_AUTO_GENERATE=true
