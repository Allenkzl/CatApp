# Copy to deploy/.env (chmod 600). Compose commands below use --env-file deploy/.env.
# Keep the tag tied to a source commit. Replace this after building/retrieving an image.
CAT_IMAGE=catapp:deploy-candidate
CAT_BIND_IP=127.0.0.1
CAT_HOST_PORT=4173
CAT_HOST_DATA_DIR=/srv/catapp/data
CAT_PUBLIC_URL=https://cats.example.com
CAT_ADMIN_USER=admin
CAT_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# Single quotes protect literal $ / # characters from Compose interpolation.
# DEEPSEEK_API_KEY='paste-key-here'
DEEPSEEK_API_KEY=
SEEDREAM_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
# Start with false, verify storage/login first; explicitly enable for real comic generation.
CAT_AUTO_GENERATE=false
